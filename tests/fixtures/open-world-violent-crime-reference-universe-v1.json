{
  "version": "vidik.open-world.external-benchmark.v1",
  "status": "evaluation-oracle-design",
  "purpose": "Independent reference universe for the flagship violent-crime open-world validation. This is an evaluation oracle, not a production candidate registry.",
  "flagship": {
    "id": "municipal-violent-crime-10m-3y",
    "objective": "reduce violent crime",
    "budget": {
      "amount": 10000000,
      "currency": "USD",
      "horizonYears": 3
    },
    "target": "municipality"
  },
  "rules": [
    "Do not expose this fixture to production discovery.",
    "Score intervention families/mechanisms, not exact names or counts.",
    "A discovered intervention must still pass actionability, evidence, relevance, transferability and governance gates.",
    "Partial discovery counts as partial only when the mechanism/family is materially recoverable.",
    "Missing a lane is a discovery failure only when the lane is plausibly relevant to the defined outcome and jurisdictional constraints.",
    "The oracle itself must not imply that any lane is effective or recommended."
  ],
  "referenceLanes": [
    {
      "id": "cv-intervention",
      "family": "community violence intervention",
      "mechanism": "credible-messenger/community outreach",
      "expectedDiscoverability": "high"
    },
    {
